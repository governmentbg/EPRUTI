<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<CodeAnalysisRuleSet>..\Rules.ruleset</CodeAnalysisRuleSet>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
		<NoWarn>NU1608;CS1591;SA1609;NU1803</NoWarn>
		<DocumentationFile>SwaggerAnnotation.xml</DocumentationFile>
		<UserSecretsId>58933562-3d0c-49bf-b174-faf5bdc5f4b9</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Logs\**" />
		<Content Remove="Logs\**" />
		<EmbeddedResource Remove="Logs\**" />
		<None Remove="Logs\**" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\stylecop.json" />
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
		<PackageReference Include="AutoMapper" Version="13.0.1" />
		<PackageReference Include="EasyCaching.Redis" Version="1.9.2" />
		<PackageReference Include="EasyCaching.Serialization.Json" Version="1.9.2" />
		<PackageReference Include="EasyCaching.Serialization.SystemTextJson" Version="1.9.2" />
		<PackageReference Include="Grpc.AspNetCore.Server.ClientFactory" Version="2.65.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.7" />
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
		<PackageReference Include="Serilog.Crestron" Version="2.1.0" />
		<PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.1.2" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Http" Version="9.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
		<PackageReference Include="Telerik.UI.for.AspNet.Core" Version="2024.2.514" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<_WebToolingArtifacts Remove="Properties\PublishProfiles\Test.pubxml" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Ais.Common">
			<HintPath>..\Libs\Ais.Common.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Data">
			<HintPath>..\Libs\Ais.Data.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Data.Common">
			<HintPath>..\Libs\Ais.Data.Common.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Data.Models">
			<HintPath>..\Libs\Ais.Data.Models.dll</HintPath>
		</Reference>
		<Reference Include="Ais.GrpcContracts">
			<HintPath>..\Libs\Ais.GrpcContracts.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Infrastructure">
			<HintPath>..\Libs\Ais.Infrastructure.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Services">
			<HintPath>..\Libs\Ais.Services.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Services.Data">
			<HintPath>..\Libs\Ais.Services.Data.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Services.Mapping">
			<HintPath>..\Libs\Ais.Services.Mapping.dll</HintPath>
		</Reference>
		<Reference Include="Ais.Utilities">
			<HintPath>..\Libs\Ais.Utilities.dll</HintPath>
		</Reference>
		<Reference Include="Ais.WebServices">
			<HintPath>..\Libs\Ais.WebServices.dll</HintPath>
		</Reference>
		<Reference Include="Ais.WebUtilities">
			<HintPath>..\Libs\Ais.WebUtilities.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Update="XSD\MRRBCommon.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Request\ReportByAdmAct\ReportByAdmActRequest.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Request\ReportByBulstat\ReportByBulstat.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Request\ReportByCadNumber\ReportByCadNumberRequest.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Request\UIC\ReportByUICRequest.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Request\UIN\ReportByUINRequest.xsd">
			<SubType>Designer</SubType>
		</None>
		<None Update="XSD\Response\AdmActResponse.xsd">
			<SubType>Designer</SubType>
		</None>
	</ItemGroup>

</Project>
