<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:common="http://egov.bg/RegiX/MRRB"
           xmlns="http://egov.bg/RegiX/MRRB/AdmActResponse"
           targetNamespace="http://egov.bg/RegiX/MRRB/AdmActResponse"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
	<xs:import namespace="http://egov.bg/RegiX/MRRB" schemaLocation="../MRRBCommon.xsd"/>
	<xs:element name="AdmActInfoResponse" type="AdmActInfoResponseType">
		<xs:annotation>
			<xs:documentation>Справка за изададени административни актове</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="AdmActInfoResponseType">
		<xs:annotation>
			<xs:documentation>Информация за изадедни административни актове</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Error" type="common:NomenclatureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Грешка, ако има такава</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmdActResponse" type="common:AmdActResponseType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
 