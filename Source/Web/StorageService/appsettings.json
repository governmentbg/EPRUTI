{
  "ConnectionStrings": {
    "GuestConnection": "",
    "LoginConnection": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Http", "Serilog.Sinks.Console", "Ais.Infrastructure" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System.Net.Http.HttpClient": "Debug",
        "System": "Error",
        "Microsoft": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithCustomClientIp",
      "WithRequestContext",
      {
        "Name": "WithCorrelationId",
        "Args": {
          "addValueIfHeaderAbsence": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
    ////"Endpoints": {
    ////  "http": {
    ////    "Url": "http://127.0.0.1:7331"
    ////  },
    ////  "Grpc": {
    ////    "Url": "http://127.0.0.1:7332",
    ////    "Protocols": "Http2"
    ////  }
    ////}
  },
  "TempDirectory": "Temp",
  "ReadFileChunkSize": 65536,
  "Jwt": {
    "Key": "",
    "Issuer": "StorageService",
    "Audience": "StorageService",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationMinutes": 1440
  },
  "localization": {
    "DefaultCulture": "bg-BG",
    "SupportedCultures": [
      {
        "Id": "",
        "Name": "bg-BG",
        "Required": true
      },
      {
        "Id": "",
        "Name": "en-US",
        "Required": true
      }
    ],
    "ResourceCacheExpirationTimeInMinutes": "15"
  },
  "Api": {
    "AutomationUserId": ""
  },
  "TempPathRegex": "^{0}[\\/\\\\]{{1,2}}\\w+[\\/\\\\]{{1,2}}\\w+[\\/\\\\]{{1,2}}\\w+[\\/\\\\]{{1,2}}{1}[\\/\\\\]{{1,2}}[^\\/\\\\]+$"
}
