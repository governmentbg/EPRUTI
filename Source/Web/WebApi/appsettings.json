{
  "ConnectionStrings": {
    "GuestConnection": "",
    "LoginConnection": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Http", "Serilog.Sinks.Console", "Serilog.Sinks.File", "Ais.Infrastructure" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System.Net.Http.HttpClient": "Debug",
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithClientAgent",
      "WithCustomClientIp",
      "WithRequestContext",
      {
        "Name": "WithCorrelationId",
        "Args": {
          "addValueIfHeaderAbsence": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "UseHttps": true,
  "easycaching": {
    "Disable": false,
    "Expiration": "00:10:00",
    "redis": {
      "CacheNulls": true,
      "SerializerName": "json",
      "dbconfig": {
        "Password": "",
        "KeyPrefix": "Mrrb.WebApi:Cache:",
        "Endpoints": [
          {
            "Host": "",
            "Port": 6379
          }
        ]
      }
    }
  },
  "localization": {
    "DefaultCulture": "bg-BG",
    "SupportedCultures": [
      {
        "Id": "",
        "Name": "bg-BG",
        "Required": true
      },
      {
        "Id": "",
        "Name": "en-US",
        "Required": true
      }
    ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "WebApi",
    "Audience": "WebApi",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationMinutes": 1440
  },
  "Api": {
    "AutomationUserId": ""
  },
  "StorageService": {
    "Url": "",
    "User": "",
    "Password": "",
    "KeepAlivePingDelay": 60,
    "KeepAlivePingTimeout": 30,
    "EnableMultipleHttp2Connections": true,
    "SkipSslCertificatesCheck": true
  },
  "Certificate": {
    "Path": "",
    "Password": "",
    "ValidateSign": false
  }
}