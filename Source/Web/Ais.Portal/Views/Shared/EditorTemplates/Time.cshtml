@model DateTime?

@{
    var htmlAttributes = ViewData.ContainsKey("htmlAttributes")
       ? ViewData["htmlAttributes"]
       : null;

    var attributes = Ais.WebUtilities.Helpers.HtmlHelperExt.MergeHtmlAttributes(
        htmlAttributes,
        new Dictionary<string, object>
        {
            { "id", Guid.NewGuid().ToString() },
        });
}

@(Html.Kendo().TimePickerFor(m => m).HtmlAttributes(attributes).Deferred())