{
  "RateLimitOptions": {
    "Type": "None"
  },
  "ModuleName": "Mrrb.Portal",
  "PasswordRegex": "^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!@$%^&*-]).{8,}$",
  "ConnectionStrings": {
    "GuestConnection": "",
    "LoginConnection": "",
    "RedisConnection": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Http", "Serilog.Sinks.Console", "Ais.Infrastructure" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System.Net.Http.HttpClient": "Debug",
        "System": "Error",
        "Microsoft": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithClientAgent",
      "WithCustomClientIp",
      "WithRequestContext",
      {
        "Name": "WithCorrelationId",
        "Args": {
          "addValueIfHeaderAbsence": true
        }
      }
    ]
  },
  "Cms": {
    "TermsPageUrl": "Terms",
    "CookiesPageUrl": "GDPR"
  },
  "AllowedHosts": "*",
  "Saml2": {
    "ReadFromCert": false,
    "ServiceExt": "",
    "SPProvidedID": "",
    "ProviderExt": "",
    "LevelOfAssuranceExt": "",
    "SigningCertificateThumbPrint": "",
    "IdPMetadata": "",
    "SPMetadata": "",
    "Issuer": "",
    "Attributes": {
      "PersonIdentifier": "",
      "PersonName": "",
      "Email": "",
      "Phone": "",
      "LatinName": "",
      "BirthName": "",
      "DateOfBirth": "",
      "Gender": "",
      "PlaceOfBirth": "",
      "X509": "",
      "CanonicalResidenceAddress": ""
    },
    "EnableEAuthentication": true
  },
  "easycaching": {
    "Disable": false,
    "Expiration": "00:10:00",
    "redis": {
      "CacheNulls": true,
      "SerializerName": "json",
      "dbconfig": {
        "KeyPrefix": "Mrrb.Portal:Cache:"
      }
    }
  },
  "localization": {
    "DefaultCulture": "bg-BG",
    "SupportedCultures": [
      {
        "Id": "",
        "Name": "bg-BG",
        "Required": true
      },
      {
        "Id": "",
        "Name": "en-US",
        "Required": true
      }
    ]
  },
  "TableExport": {
    "ExportTypes": "xlsx,csv, pdf, pdf A4, pdf A3, pdf Dynamic"
  },
  "Attachment": {
    "VirtualPath": "/Uploads",
    "UploadsDirPath": "",
    "Domain": "",
    "UserName": "",
    "Password": "",
    "AsyncUploadChunkSize": 307200, // In bytes 307200 ~ 300КB,
    "MaxFileSize": 20 // Max file size in MB
  },
  "OpenData": {
    "VirtualPath": "/OpenData",
    "UploadsDirPath": "",
    "Domain": "",
    "UserName": "",
    "Password": ""
  },
  "NewsContentTrimLength": 150,
  "Api": {
    "AutomationUserId": ""
  },
  "StorageService": {
    "Url": "",
    "User": "",
    "Password": "",
    "KeepAlivePingDelay": 60,
    "KeepAlivePingTimeout": 30,
    "EnableMultipleHttp2Connections": true,
    "SkipSslCertificatesCheck": true
  },
  "Session": {
    "IdleTimeout": 60, // In minutes
    "WarningTimeout": 54 // In minutes
  },
  "Authentication": {
    "Expires": 55, // In minutes
    "RememberMeExpires": 7, // In days
    "ValidateInterval": 10, // In minutes
    "TokenTimeout": "5" //In minutes
  },
  "Application": {
    "InquiryValidDays": 30, // In days
    "MaxObjectsPerService": 4000,
    "ValidateSign": false
  },
  "UseHttps": true,
  "MrrbWebApi": {
    "Url": "",
    "Timeout": 120,
    "User": "",
    "Password": ""
  },
  "AutomationUserId": "", // anonymous_portal,
  "EmailOptions": {
    "Host": "",
    "Port": "",
    "EnableSsl": "",
    "Address": "",
    "User": "",
    "Password": "",
    "ValidationRegex": ""
  },
  "EncryptKey": "",
  "LinkExpirationPeriod": "1440",
  "CustomHeaders": {
    "Add": {
      "Vary": "",
      "X-Frame-Options": "",
      "X-Xss-Protection": "",
      "X-Content-Type-Options": "",
      "X-Permitted-Cross-Domain-Policies": "",
      "Strict-Transport-Security": "",
      "Content-Security-Policy": ""
    }
  },
  "NotificationCountReadTimeInMinutes": 1,
  "BalanceReadTimeInMinutes": 1,
  "Cors": {
    "Origins": [ "localhost:*", "127.0.0.1:*" ]
  },
  "Search": {
    "DefaultLimit": 200,
    "MaxLimit": 1000
  }
}