@using global::Ais.Data.Models.OutAdmAct
@using Ais.Portal.Controllers
@using Microsoft.Extensions.Localization
@using Ais.Utilities.Extensions
@using global::Ais.Data.Models.Document
@using System.Text.RegularExpressions
@using Ais.WebUtilities.Extensions
@using System.Linq
@inject IStringLocalizer Localizer
@model OutAdmAct
@{
    <div class="step-box">
        <div class="step-box-head-unordered">
            <h3 class="step-box-title">
                @Localizer["Versions"]
            </h3>
        </div>
        <div class="step-box-body versions-wrap">
            @if (Model?.Versions?.Count() > 0)
            {
                @for (int i = 1; i < Model?.Versions?.Count(); i++) // Start from 1 since the newest xml is current latest actual info.
                {
                    var file = Model.Versions[i];
                    <div class="info-row">
                        <div class="ib">
                            @Localizer["Version"]:
                            <strong> @(Model?.Versions.Count - i)</strong>
                        </div>
                        <div class="ib">
                            @Localizer["Date"]:
                            <strong>@(file?.Date.ToString() ?? "")</strong>
                        </div>
                        <a class="k-ml-auto autosize open-model-version-js" title="@Localizer["See"]" data-name="@Model.RegNumber" data-fileid="@file.XmlFileId" data-date="@file.Date">
                            <i class="k-i-info k-icon k-font-icon"></i>
                        </a>
                    </div>
                }
            }
        </div>
    </div>
}