@using Ais.Data.Models.OutAdmAct
@using Ais.Portal.Controllers
@using Microsoft.Extensions.Localization
@using Ais.Utilities.Extensions
@using global::Ais.Data.Models.Document
@using System.Text.RegularExpressions
@using Ais.WebUtilities.Extensions
@using System.Linq
@inject IStringLocalizer Localizer
@model OutAdmAct
@{
    if (Model.Attachments.IsNotNullOrEmpty())
    {
        <div class="step-box">
            <div class="step-box-head-unordered">
                <h3 class="step-box-title">
                    @Localizer["CopyAdmAct"]
                </h3>
            </div>
            <div class="step-box-body">
                @foreach (var group in Model?.AttachmentGroups)
                {
                    ViewBag.Group = group;
                    <div class="mainGroup">
                        @await Html.PartialAsync("~/Areas/OutAdministrativeAct/Views/AdmActRegister/Info/_AttachmentGroup.cshtml", Model)
                    </div>
                }
            </div>
        </div>
    }
}

<script>
    $(function () {
        $(".mainGroup").each(function () {
            if ($(this).find(".uploadedFile").length == 0) {
                $(this).remove();
            }

            let emptyUpload = $(this).find(".k-upload-empty")
            if (emptyUpload.length == 0) {
                $(emptyUpload).remove();
            }
        })
    })
</script>