@inject IStringLocalizer Localizer
@using global::Ais.Data.Models.DynamicValidation
@using global::Ais.Data.Models.OutAdmAct
@using Ais.WebServices.Services.SessionStorage
@using Microsoft.Extensions.Localization
@using Ais.Utilities.Extensions
@model OutAdmAct
@inject ISessionStorageService sessionStorageService

@{
    var validations = await sessionStorageService.GetAsync<List<DynamicValidation>>("DynamicValidations");
}

<div id="applicants" class="step-box">
    <div class="step-box-head-unordered">
        <h3 class="step-box-title">
            @Localizer["Applicant"]
        </h3>
    </div>
    <div class="step-box-body applicants-js">
        @if (Model?.Applicants.IsNotNullOrEmpty() == true)
        {
            var index = 1;
            for(int i = 0; i < Model.Applicants.Count; i++)
            {
                <div class="flex info-row">
                    <div class="number">@(index++).</div>
                    <div class="left">
                        @(Html.RenderInfoIfVisible(Model, m => m.Applicants[i].Recipient.FirstAndLastName, validations, Localizer["FullName"]))
                        @(Html.RenderInfoIfVisible(Model, m => m.Applicants[i].Recipient.EgnBulstat, validations, Localizer["EgnBulstat"]))
                        @(Html.RenderAddressInfoIfVisible(Model, m => m.Applicants[i].Recipient.ContactData, validations, Localizer["Address"]))
                    </div>
                    <div class="bttn-wrap w-auto">
                    </div>
                </div>
            }
        }
    </div>
</div>