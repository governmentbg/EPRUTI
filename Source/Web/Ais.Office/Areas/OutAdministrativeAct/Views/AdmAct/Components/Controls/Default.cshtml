@using Ais.Office.Areas.OutAdministrativeAct.Controllers;
@using Ais.WebUtilities.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer
@{
    if (Url.HasRightsToAction(nameof(OutApplicationController.Edit), typeof(OutApplicationController)))
    {
        <a href="\\#" class="k-small k-button edit-outdoc-js" data-searchqueryid="@ViewBag.SearchQueryId" title="@Localizer["Edit"]">
            <i class="k-i-edit k-icon k-font-icon"></i>
        </a>
    }

    if (Url.HasRightsToAction(nameof(OutApplicationController.AdmActStateUpsert), typeof(OutApplicationController)))
    {
        <a href="\\#" class="k-small k-button edit-admact-state-js" data-searchqueryid="@ViewBag.SearchQueryId" title="@Localizer["EditState"]">
            <i class="k-i-gears k-icon k-font-icon"></i>
        </a>
    }
}