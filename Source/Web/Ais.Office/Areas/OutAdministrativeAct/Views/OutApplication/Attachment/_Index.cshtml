@using global::Ais.Data.Models.AdmActAttachment
@using global::Ais.Data.Models.Attachment;
@using global::Ais.Data.Models.Helpers
@using global::Ais.Data.Models.Service
@using Ais.Utilities.Extensions;
@using Microsoft.Extensions.Localization;
@inject IStringLocalizer Localizer
@model Ais.Data.Models.Document.OutDocument

@functions
{
    async Task RenderUploadAsync(AttachmentType type, Guid? typeId, bool isOnlyChild, ICollection<Attachment> attachments = null)
    {

        <div class="attachment-group-wrapper @(isOnlyChild ? "main" : null)">

            @foreach (var attachment in attachments!)
            {
                ViewBag.DontShowRelateObject = true;
                ViewBag.Attachment = attachment;
                await Html.RenderPartialAsync("~/Views/Application/Attachment/_Attachment.cshtml", type);
                <div class="step-box-footer text-right">
                    <button type="button" class="bttn main small add-outdoc-attachment-js" data-unique-id="@Model.UniqueId" value="@typeId" data-type-id="@type.Id">
                        @Localizer["Add"]
                    </button>
                </div>

            }
        </div>

    }

    async Task RenderAttachmentAsync(AttachmentGroup group)
    {
        if (group.Attachments != null && group.Attachments.Count() > 0)
        {
            foreach (var attachmentType in group.Attachments)
            {
                var isOnlyChild = false;
                @if (group?.Children != null && group.Children.Count == 0 && group?.Attachments?.Count > 0)
                {
                    isOnlyChild = true;

                    if (attachmentType.Type.Title.ToString() != group.Name.ToString())
                    {
                        <label>@attachmentType.Type.Title</label>
                    }
                }
                else
                {
                    <label>@attachmentType.Type.Title</label>
                }

    if (EnumHelper.GetServiceAttachmentTypeIdByType(ServiceAttachmentType.AlwaysRequired) == attachmentType?.Required?.Id)
                {
                    ViewBag.Required = true;
                }

                var filteredAttachments = Model?.Attachments?.Where(x => x.Type.Id == attachmentType.Id)?.ToList();

                ViewBag.GroupRelDocId = attachmentType.Id;
                if (filteredAttachments.IsNullOrEmpty())
                {
                    filteredAttachments = new List<Attachment>() { null };
                }

                var type = new AttachmentType
                    {
                        Id = attachmentType.Id,
                        Title = attachmentType.Type.Title,
                        Extensions = attachmentType.Type.Extensions,
                        MaxSize = attachmentType.Type.MaxSize
                    };

                await RenderUploadAsync(type, attachmentType.Type.Id, isOnlyChild, filteredAttachments);
            }
        }
    }

    async Task RenderAttachmentGroupsAsync(AttachmentGroup group)
    {
        <fieldset>
            <legend class="attachment-group-name">@group.Name</legend>
            <div class="attachments-wrap">
                @if (group.HasChildren == true)
                {
                    @if (group.Attachments != null && group.Attachments.Count() > 0)
                    {
                        group.HasChildren = false;
                        await this.RenderAttachmentAsync(group);
                        group.HasChildren = true;
                    }

                    @foreach (var child in group.Children)
                    {
                        await RenderAttachmentGroupsAsync(child);
                    }
                }
                else
                {
                    if (group.Attachments != null && group.Attachments.Count() > 0)
                    {
                        await this.RenderAttachmentAsync(group);
                    }
                }
            </div>
        </fieldset>
    }
}
@{
    var group = ViewBag.Group as AttachmentGroup;
    // // var type = ViewBag.AttachmentType as AttachmentType;
    await RenderAttachmentGroupsAsync(group);
}