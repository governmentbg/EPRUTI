@using Ais.Office.Areas.Reports.Controllers.Payments
@using Ais.Utilities.Extensions
@using Ais.WebUtilities.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer
@{
    var infoUrl = Url.DynamicAction(nameof(ClientPaymentOrderReportsController.Info), typeof(ClientPaymentOrderReportsController));
}
<script id="ClientPaymentOrderInfoTemplate" type="text/x-kendo-template">
    @{
        if (infoUrl.IsNotNullOrEmpty())
        {
            @:#if(Id){#<a href="@infoUrl?id=#:Id#" class="js-trigger-popup" title="@(Localizer["Info"]): #:PaymentOrderNumber#">#:PaymentOrderNumber#</a>#}else{# #:PaymentOrderNumber# #}#
        }
        else
        {
            @:#:PaymentOrderNumber#
        }
    }
</script>