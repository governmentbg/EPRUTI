@using Ais.Office.Areas.Admin.Controllers
@using Ais.Utilities.Extensions
@using Ais.WebUtilities.Extensions
@{
    var clientInfo = Url.DynamicAction(nameof(ClientsController.MenuInfo), typeof(ClientsController));
}
<script id="CustomerTemplate" type="text/x-kendo-template">
    @{
        if (clientInfo.IsNotNullOrEmpty())
        {
            @:#if(CustomerId){#<a href="@clientInfo?clientId=#:CustomerId#" class="js-trigger-popup" data-height="90%" data-width="90%" title="#:CustomerDesc#">#:CustomerDesc#</a>#}else{# #:CustomerDesc# #}#
        }
        else
        {
            @:#:CustomerDesc#
        }
    }
</script>
<script id="CustomerKnikTemplate" type="text/x-kendo-template">
    @{
        if (clientInfo.IsNotNullOrEmpty())
        {
            @:#if(CustomerId){#<a href="@clientInfo?clientId=#:CustomerId#" class="js-trigger-popup" data-height="90%" data-width="90%" title="#:CustomerDesc#">#:CustomerKnik#</a>#}else{# #:CustomerKnik# #}#
        }
        else
        {
            @:#:CustomerKnik#
        }
    }
</script>