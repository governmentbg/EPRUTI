@using Ais.Office.Controllers
@using Ais.Office.ViewModels.Reports.InquiryReports
@using Ais.WebUtilities.Extensions
@using Ais.Utilities.Extensions
@{
    var downloadLink = Url.DynamicActionWithRightsCheck(nameof(AttachmentController.Download), typeof(AttachmentController));
}
<script id="RegNumTemplate" type="text/x-kendo-template">
    @{
        if (downloadLink.IsNotNullOrEmpty())
        {
            @:#if(data.ForPayment == false && data.FileIds && data.FileIds.length > 0){#
            @:    <a href="@(downloadLink)?ids=#:FileIds.join('&ids=')#">#:@nameof(InquiryReportTableViewModel.RegNum)#</a>
            @:#}else{#
            @:    #:@nameof(InquiryReportTableViewModel.RegNum)#
            @:#}#
        }
        else
        {
            @:#:@nameof(InquiryReportTableViewModel.RegNum)#
        }
    }
</script>