@using Ais.Office.Areas.Admin.Controllers;
@using Ais.Office.Controllers
@using Ais.Office.ViewModels.Faq;
@using Ais.Office.ViewModels.FieldControl
@using Microsoft.Extensions.Localization;
@using Ais.WebUtilities.Extensions;
@using Kendo.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ais.WebUtilities.Helpers

@inject IStringLocalizer Localizer;
@model FieldViewModel
@section Breadcrumbs
{
    @{
        await Html.RenderPartialAsync("_Breadcrums");
    }
}

<form method="post" class="dirty-check" action="@Url.DynamicAction(nameof(FieldControlController.Upsert), typeof(FieldControlController))"
      data-ajax="true"
      data-ajax-method="POST"
      data-ajax-success="core.onKendoWindowSuccessCallback">
    @Html.ValidationSummary(true)
    @Html.AntiForgeryToken()
    @Html.Hidden("searchQueryId", ViewBag.SearchQueryId as string)
    @Html.HiddenFor(m => m.DocumentTypeId)
    @if (Model.Id.HasValue)
    {
        @Html.HiddenFor(m => m.Id)
    }
    <div class="form-row">
        <div class="form-input quad">
            @Html.LabelFor(m => m.PropertyName, new { @class = "required" })
            @(Html.Kendo().TextBoxFor(m => m.PropertyName))
        </div>
        <div class="form-input quad">
            @Html.InfoLabel(Localizer["ResourceKey"], key: "ResourceKeyInfo")
            @(Html.Kendo().TextBoxFor(m => m.ResourceKey))
        </div>
        <div class="form-input quad">
            @Html.LabelFor(m => m.PropertyPath, new { @class = "required" })
            @(Html.Kendo().TextBoxFor(m => m.PropertyPath))
        </div>
        <div class="form-input quad">
            @Html.LabelFor(m => m.Step)
            @(Html.Kendo().NumericTextBoxFor(m => m.Step).Format("#").Decimals(0).Step(1))
        </div>
    </div>
    <div class="form-row">
        <div class="form-input quad">
            @Html.LabelFor(m => m.IsRequired)
            @(Html.Kendo().CheckBoxFor(m => m.IsRequired).Checked(Model.IsRequired))
        </div>
        <div class="form-input quad">
            @Html.LabelFor(m => m.IsWebVisible)
            @(Html.Kendo().CheckBoxFor(m => m.IsWebVisible).Checked(Model.IsWebVisible))
        </div>
    </div>
    <div class="clear"></div>
    <div class="button-wrap fullwidth">
        <button type="submit" class="bttn main caps right">
            @Localizer["Save"]
        </button>
        <button class="bttn  third  right closeKendoWindow-js">
            @Localizer["Close"]
        </button>
    </div>
    <div class="clear"></div>
</form>

