@using global::Ais.Data.Models.Attachment
@using global::Ais.Data.Models.Nomenclature
@using global::Ais.Data.Models.Signature
@using Ais.Infrastructure.KendoExt
@using Ais.Office.Areas.Admin.Controllers
@using Ais.Office.Controllers
@using Ais.Office.ViewModels.OutApplicationTypes
@using Ais.Utilities.Extensions
@using Ais.WebUtilities.Extensions
@using Ais.WebUtilities.Helpers
@using Kendo.Mvc.TagHelpers
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Configuration
@using UploadFile = Ais.Infrastructure.KendoExt.UploadFile
@inject IStringLocalizer localizer
@inject IConfiguration Configuration
@model Ais.Office.ViewModels.OutApplicationTypes.OutApplicationTypeViewModel
@{
    var asyncUploadChunkSize = Configuration.GetValue<double>("Attachment:AsyncUploadChunkSize");
    var officeTemplateBgType = ViewBag.OfficeTemplateBGType as AttachmentType ?? new AttachmentType();
    var outDocTypes = ViewBag.OutDocTypes as List<Nomenclature>;
    var docName = this.ViewBag.DocName;
}
@{
    var selectedTab = ViewBag.SelectedTab is OutDocumentTypesTabs ? (OutDocumentTypesTabs)ViewBag.SelectedTab : OutDocumentTypesTabs.OutDocumentTypes;
    var searchAttachments = Url.DynamicActionWithRightsCheck(nameof(OutApplicationTypesController.GetOutDocAttachments), typeof(OutApplicationTypesController), new { doctypeid = Model.Id, docName = ViewBag.DocName as string, area = "Admin" });
    var searchFields = Url.DynamicActionWithRightsCheck(nameof(FieldControlController.Index), typeof(FieldControlController), new { documentId = Model.Id, area = "Admin" });

    var upsert = Url.DynamicActionWithRightsCheck(nameof(OutApplicationTypesController.Upsert), typeof(OutApplicationTypesController), new { doctypeid = Model.Id, area = "Admin" });
}
@section Scripts
{
    <script src="~/bundles/admin_services.min.js" asp-append-version="true"></script>
    <script src="~/bundles/admin_outapplicationtypes.min.js" asp-append-version="true"></script>
}

@section Breadcrumbs
{
    @{
        await Html.RenderPartialAsync("_Breadcrums");
    }
}
@(Html.Kendo().TabStrip()
 .Name("createServiceTabStrip")
 .SelectedIndex(selectedTab.GetHashCode())
 .HtmlAttributes(new { @class = "application-types" })
 .Items(tabstrip =>
 {
     if (upsert.IsNotNullOrEmpty())
     {
         tabstrip.Add()
         .Text(localizer["OutDocumentTypes"])
         .LoadContentFrom(Url.Action("Upsert", "OutApplicationTypes", new { id = Model.Id, area = "Admin" }))
         .Enabled(true);
     }
     if (searchAttachments.IsNotNullOrEmpty())
     {
         tabstrip.Add()
         .Text(localizer["Attachments"])
         .LoadContentFrom(searchAttachments)
         .Enabled(!Model.IsNew);
     }
     if (searchFields.IsNotNullOrEmpty())
     {
         tabstrip.Add()
         .Text(localizer["FieldControl"])
         .LoadContentFrom(searchFields)
         .Enabled(!Model.IsNew);
     }
     tabstrip.Add()
        .Text(docName)
        .HtmlAttributes(new { @class = "ml-auto" })
        .Enabled(false);
 })
 .Deferred())