@using Ais.Office.Areas.Admin.Controllers;
@using Ais.WebUtilities.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer Localizer
@{
    var controllerType = typeof(RegistrationRequestsController);
    if (this.Url.HasRightsToAction("Upsert", controllerType))
    {
        <a class="k-small k-button edit-request-js" data-searchqueryid="@ViewBag.SearchQueryId" title="@Localizer["Edit"]">
            <i class="k-i-edit k-icon k-font-icon"></i>
        </a>
    }
}